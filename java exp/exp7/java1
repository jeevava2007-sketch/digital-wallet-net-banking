class Wallet {

    String name;
    int accountNumber;
    int balance;

    // Constructor
    Wallet(String name, int accountNumber, int balance) {
        this.name = name;
        this.accountNumber = accountNumber;
        this.balance = balance;
    }

    // Display method
    void display() {
        System.out.println("Name: " + name);
        System.out.println("Account Number: " + accountNumber);
        System.out.println("Balance: " + balance);
    }
}

public class Main {
    public static void main(String[] args) {

        Wallet user = new Wallet("jeeva", 12345, 5000);

        user.display();
    }
}