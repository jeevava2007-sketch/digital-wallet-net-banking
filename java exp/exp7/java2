class Wallet {

    // Private data members (Access Modifier)
    private String name;
    private int accountNumber;
    private int balance;

    // Constructor
    public Wallet(String name, int accountNumber, int balance) {
        this.name = name;
        this.accountNumber = accountNumber;
        this.balance = balance;
    }

    // Public method
    public void display() {
        System.out.println("Name: " + name);
        System.out.println("Account Number: " + accountNumber);
        System.out.println("Balance: " + balance);
    }

    // Static method
    public static void bankName() {
        System.out.println("Bank Name: Digital Wallet Bank");
    }
}

public class Main {
    public static void main(String[] args) {

        // Calling static method
        Wallet.bankName();

        // Creating object
        Wallet user = new Wallet("Jeeva", 12345, 5000);

        // Calling instance method
        user.display();
    }
}